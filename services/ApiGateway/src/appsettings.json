{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-auth": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "meal-recipes": {
        "ClusterId": "meal",
        "Match": { "Path": "/api/recipes/{**catch-all}" }
      },
      "meal-meal": {
        "ClusterId": "meal",
        "Match": { "Path": "/api/meal/{**catch-all}" }
      },
      "plan-plans": {
        "ClusterId": "plan",
        "Match": { "Path": "/api/plans/{**catch-all}" }
      },
      "plan-mealplan": {
        "ClusterId": "plan",
        "Match": { "Path": "/api/mealplan/{**catch-all}" }
      },
      "graphql-exact": {
        "ClusterId": "bff",
        "Match": { "Path": "/graphql" }
      },
      "graphql-catchall": {
        "ClusterId": "bff",
        "Match": { "Path": "/graphql/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "d1": { "Address": "http://identity_service:80" }
        }
      },
      "meal": {
        "Destinations": {
          "d1": { "Address": "http://meal_recipe_service:80" }
        }
      },
      "plan": {
        "Destinations": {
          "d1": { "Address": "http://plan_service:80" }
        }
      },
      "bff": {
        "Destinations": {
          "d1": { "Address": "http://gateway_bff:80" }
        }
      }
    }
  }
}
